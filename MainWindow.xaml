<Window x:Class="SummaBarcodeCreater.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SummaBarcodeCreater"
             mc:Ignorable="d" 
             Loaded="Window_Loaded" MinWidth="330" Width="330" Height="540" ResizeMode="NoResize" Title="Настройки файла резки" WindowStartupLocation="CenterScreen" Topmost="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>



    <Grid Margin="0,0,0,0">

        <ComboBox Name="Velosity" MinWidth="100" Height="24" Margin="120,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <ComboBox Name="Overcut" MinWidth="100" Height="24" Margin="120,50,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <TextBlock Text="Скорость резки" Margin="20,23,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Text="Перерез кривой" Margin="20,54,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Text="Размытие кривой" Margin="45,81,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Text="Добавление второго баркода" Margin="45,101,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Text="Добавить имя документа сверху макета" Margin="45,123,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <CheckBox Name="Smothing" Margin="20,83,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <CheckBox Name="Barcode2" Margin="20,103,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <CheckBox Name="NameDoc" Margin="20,123,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Name="PathCon" Margin="20,203,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Путь сохранения файла резки:"/>
        <TextBox Name="Path" Margin="20,222,105,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="24" IsEnabled="False"/>
        <Button Name="PathButton" Margin="0,222,20,0" HorizontalAlignment="Right" VerticalAlignment="Top" Width="80" Height="24" Content="Выбрать" Click="FolderClick"/>
        <Button Name="OK" Margin="20,440,20,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="30" Content="Сохранить настройки" Click="Ok_click"/>
        <TextBlock Name="ColorNm" Margin="20,245,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Имена спотовых цветов для поиска контура"/>
        <TextBox Name="Color" Margin="20,264,20,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="24"/>
        <TextBlock Name="Bleed" Margin="20,292,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Отступы от меток до края страницы:"/>
        <TextBlock Name="up" Margin="20,317,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Сверху:"/>
        <TextBlock Name="down" Margin="20,347,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Снизу:"/>
        <TextBlock Name="right" Margin="20,377,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Справа:"/>
        <TextBlock Name="bottom" Margin="20,407,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Слева:"/>
        <TextBox x:Name="UpBleed" Margin="73,312,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="24"/>
        <TextBox x:Name="DownBleed" Margin="73,342,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="24"/>
        <TextBox x:Name="RightBleed" Margin="73,372,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="24"/>
        <TextBox x:Name="LeftBleed" Margin="73,402,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="24"/>
        <TextBlock Name="PlxCheckText" Text="Создать *plx файл для сервера резки ColorGate" Margin="45,143,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <CheckBox x:Name="PlxCheck" Margin="20,144,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <CheckBox x:Name="CustomPLt" Margin="20,165,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Text="Использовать встроенный экспорт" Margin="45,164,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <CheckBox Name="PdfContour" Margin="20,185,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Name="PdfContourText" Text="Использовать в качестве файла резки pdf" Margin="45,184,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>


</Window>
